<Window x:Class="ProgramDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProgramDock 设置"
        Width="720"
        Height="650"
        MinWidth="620"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF0B1018"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Border Margin="10"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#2B3D51"
            BorderThickness="1"
            CornerRadius="20">
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="设置"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="调整扫描范围、启动行为和全局快捷键"
                               Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="×"
                        Width="36"
                        Height="32"
                        Padding="0"
                        FontSize="20"
                        Click="OnCloseClick" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="扫描范围"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentStrongBrush}" />
                    <TextBlock Text="默认选择所有可用固定磁盘；扫描在后台运行，权限不足的目录会自动跳过。"
                               Margin="0,6,0,10"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Border Background="#131E2A"
                            BorderBrush="#2D4156"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">
                        <StackPanel>
                            <ItemsControl x:Name="DriveItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Padding="2,4"
                                                  ToolTip="{Binding Path}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="添加自定义文件夹"
                                    Width="150"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Click="OnAddFolderClick" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="文件类型"
                               Margin="0,22,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentStrongBrush}" />
                    <TextBlock Text="用逗号分隔扩展名；修改后下一次扫描生效。"
                               Margin="0,6,0,8"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="ExtensionsTextBox"
                             FontSize="13"
                             Text=".exe, .com, .bat, .cmd, .lnk, .msi, .msix, .appx" />

                    <TextBlock Text="自动分类"
                               Margin="0,22,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentStrongBrush}" />
                    <TextBlock Text="默认将 Windows 核心组件、驱动/运行时、安装卸载和维护工具归入“系统/辅助”；普通用户程序、便携程序和常用 Windows 工具归入“直接使用”。主界面右键可手动修正。"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="启动行为"
                               Margin="0,22,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentStrongBrush}" />
                    <CheckBox x:Name="ScanOnStartupCheck"
                              Content="启动时自动扫描"
                              Checked="OnCheckChanged"
                              Unchecked="OnCheckChanged" />
                    <CheckBox x:Name="CloseToTrayCheck"
                              Content="关闭窗口时隐藏到托盘"
                              Checked="OnCheckChanged"
                              Unchecked="OnCheckChanged" />
                    <CheckBox x:Name="HideAfterLaunchCheck"
                              Content="启动程序后自动隐藏启动器"
                              Checked="OnCheckChanged"
                              Unchecked="OnCheckChanged" />
                    <CheckBox x:Name="StartWithWindowsCheck"
                              Content="登录 Windows 后自动启动"
                              Checked="OnCheckChanged"
                              Unchecked="OnCheckChanged" />
                    <CheckBox x:Name="ShowHiddenCheck"
                              Content="显示已隐藏的程序"
                              Checked="OnCheckChanged"
                              Unchecked="OnCheckChanged" />

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="全局快捷键"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentStrongBrush}" />
                            <TextBlock Text="格式示例：Ctrl+Alt+Space；留空表示关闭。"
                                       Margin="0,6,0,8"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="HotkeyTextBox"
                                     FontSize="13"
                                     Text="Ctrl+Alt+Space" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="每页图标数"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentStrongBrush}" />
                            <TextBlock Text="建议 24–60"
                                       Margin="0,6,0,8"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox x:Name="PageSizeComboBox"
                                      Height="34"
                                      FontSize="13"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="30 个" Tag="30" />
                                <ComboBoxItem Content="40 个" Tag="40" />
                                <ComboBoxItem Content="50 个" Tag="50" />
                                <ComboBoxItem Content="60 个" Tag="60" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,22,0,0"
                            Padding="13"
                            Background="#192633"
                            BorderBrush="#30465C"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock Text="安全提示：ProgramDock 只读取程序路径并在用户点击时启动，不会自动运行未知脚本。全盘扫描不需要管理员权限。"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsMessage"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Button Grid.Column="1"
                        Content="取消"
                        MinWidth="82"
                        Click="OnCancelClick" />
                <Button Grid.Column="2"
                        Content="保存"
                        MinWidth="96"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnSaveClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
